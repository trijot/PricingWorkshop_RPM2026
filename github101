        "import pandas as pd\n",
        "import numpy as np\n",
        "import random\n",
        "\n",
        "# Number of policyholders\n",
        "n = 100\n",
        "\n",
        "# Sample values\n",
        "cities = [\"Toronto\", \"Vancouver\", \"Calgary\", \"Winnipeg\", \"Montreal\", \"Ottawa\"]\n",
        "genders = [\"Male\", \"Female\"]\n",
        "policy_types = [\"Auto\", \"Home\", \"Travel\", \"Health\"]\n",
        "vehicle_types = [\"Sedan\", \"SUV\", \"Truck\", \"Electric\", \"Hybrid\"]\n",
        "\n",
        "data = {\n",
        "    \"Policy_ID\": [f\"P{1000+i}\" for i in range(n)],\n",
        "    \"Member_ID\": [f\"M{5000+i}\" for i in range(n)],\n",
        "    \"Age\": np.random.randint(18, 75, n),\n",
        "    \"Gender\": [random.choice(genders) for _ in range(n)],\n",
        "    \"City\": [random.choice(cities) for _ in range(n)],\n",
        "    \"Policy_Type\": [random.choice(policy_types) for _ in range(n)],\n",
        "    \"Vehicle_Type\": [random.choice(vehicle_types) for _ in range(n)],\n",
        "    \"Annual_Premium\": np.round(np.random.uniform(300, 2000, n), 2),\n",
        "    \"Claim_Count\": np.random.poisson(0.3, n),\n",
        "    \"Policy_Start_Year\": np.random.randint(2018, 2025, n)\n",
        "}\n",
        "\n",
        "# Create DataFrame\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# Save to CSV\n",
        "df.to_csv(\"sample_policyholders.csv\", index=False)\n",
        "\n",
        "# Preview\n",
        "df.head()"
      ],
